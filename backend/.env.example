# Backend environment variables
# Copy this file to .env and fill in your values. NEVER commit .env.

PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/insurance?retryWrites=true&w=majority
CORS_ORIGIN=http://localhost:5173

# ML service
ML_MODE=mock                      # mock | remote
ML_SERVICE_URL=http://localhost:8000

# LLM
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=                        # e.g. gemini-1.5-flash
LLM_TIMEOUT_MS=12000
